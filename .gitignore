node_modules/
*.log
.DS_Store

# Runtime loop state is written here at run time; keep the dirs (via .gitkeep)
# but ignore the generated state files.
loop/state/heartbeat.json
loop/state/progress.md
loop/state/artifacts/round-*.json
loop/state/logs/*
!loop/state/logs/.gitkeep
loop/state/knowledge/*
!loop/state/knowledge/.gitkeep
# patterns/registry.yaml ships as a committed empty stub (schema_version: 1, findings: [])
# from the scaffold; the discovery pass writes findings into it at run time. It is the
# live registry, but the empty stub is tracked so the path exists for downstream issues.
