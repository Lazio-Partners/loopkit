{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loopkit.dev/schema/verdict.schema.json",
  "title": "loopkit verdict",
  "description": "The reviewer agent's single machine-read output for one finding. Structure only; the four cross-field rules are driver-enforced and documented in docs/contracts.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "finding_id",
    "verdict",
    "confidence",
    "reviewer_model",
    "worker_model",
    "checks",
    "findings",
    "blocking_reasons",
    "human_checkpoint_required",
    "next_action",
    "evidence"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "finding_id": {
      "type": "string",
      "pattern": "^LK-\\d{4}$",
      "description": "Universal join key. Equals registry.id and round.finding_id."
    },
    "verdict": {
      "type": "string",
      "enum": ["approve", "reject", "needs_changes"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reviewer_model": { "type": "string", "minLength": 1 },
    "worker_model": { "type": "string", "minLength": 1 },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tests", "baseline", "app_drive"],
      "properties": {
        "tests": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ran", "passed"],
          "properties": {
            "ran": { "type": "boolean" },
            "passed": { "type": "boolean" },
            "summary": { "type": "string" }
          }
        },
        "baseline": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ran", "passed"],
          "properties": {
            "ran": { "type": "boolean" },
            "passed": { "type": "boolean" },
            "summary": { "type": "string" }
          }
        },
        "app_drive": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ran", "passed"],
          "properties": {
            "ran": { "type": "boolean" },
            "passed": { "type": "boolean" },
            "summary": { "type": "string" }
          }
        }
      }
    },
    "findings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["good", "bad", "ugly", "tests"],
      "properties": {
        "good": { "type": "array", "items": { "type": "string" } },
        "bad": { "type": "array", "items": { "type": "string" } },
        "ugly": { "type": "array", "items": { "type": "string" } },
        "tests": { "type": "array", "items": { "type": "string" } }
      }
    },
    "blocking_reasons": {
      "type": "array",
      "items": { "type": "string" }
    },
    "human_checkpoint_required": { "type": "boolean" },
    "next_action": {
      "type": "string",
      "enum": ["open_pr", "return_to_worker", "park", "abort"]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind"],
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "path": { "type": "string" },
          "ref": { "type": "string" }
        }
      }
    }
  }
}
