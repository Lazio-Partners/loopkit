<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.loopkit.loop</string>
    <key>ProgramArguments</key>
    <array>
      <string>/bin/bash</string>
      <string>__REPO_ROOT__/loop/schedule/run-scheduled.sh</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
      <key>LOOPKIT_MODEL</key>
      <string>&lt;your-model-id&gt;</string>
      <key>LOOPKIT_SKILL</key>
      <string>/loop-discover</string>
      <key>LOOPKIT_MAX_ITERATIONS</key>
      <string>1</string>
      <key>PI_BIN</key>
      <string>pi</string>
    </dict>
    <key>StartCalendarInterval</key>
    <dict>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>__REPO_ROOT__/loop/state/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>__REPO_ROOT__/loop/state/logs/launchd.err.log</string>
  </dict>
</plist>
