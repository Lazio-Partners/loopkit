{
  "name": "loopkit",
  "version": "0.0.0",
  "description": "A public, MIT-licensed toolkit that brings loop engineering to the pi coding-agent harness: the five moves wired into one tested, guarded loop.",
  "license": "MIT",
  "type": "module",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/loopkit/loopkit.git"
  },
  "keywords": [
    "pi",
    "loop-engineering",
    "claude-code",
    "agents",
    "ci"
  ],
  "bin": {
    "loopkit-readiness": "tools/loop-readiness.mjs"
  },
  "scripts": {
    "lint": "node tools/leak-check.mjs",
    "readiness": "node tools/loop-readiness.mjs",
    "validate:schemas": "node tools/validate-schemas.mjs",
    "validate:registry": "node patterns/validate-registry.mjs",
    "compat-check": "node tools/compat-check.mjs",
    "test:connectors": "node --test tests/connectors/*.test.mjs",
    "test:schedule": "node --test tests/schedule/*.test.mjs",
    "leak-check": "node tools/leak-check.mjs",
    "test": "npm run validate:schemas && node --test tools/*.test.mjs patterns/*.test.mjs tests/**/*.test.mjs examples/first-loop/test/*.test.mjs examples/ship-pipeline/test/*.test.mjs && node tools/check-four-costs.mjs"
  },
  "optionalDependencies": {
    "@earendil-works/pi-coding-agent": "0.80.x"
  },
  "devDependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "yaml": "2.5.1"
  },
  "engines": {
    "node": ">=20"
  }
}
